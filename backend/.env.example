# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   copy .env.example .env
# .env 는 .gitignore 에 걸려 있다. 절대 커밋하지 말 것.

# ─── LLM 프로바이더 ───────────────────────────────────────
# 아래 프리셋 중 하나만 주석을 풀어 쓴다. 코드는 LLM_PROVIDER 하나로 프로바이더를 교체한다. (CLAUDE.md 2.3)
#
# [프리셋 1] 로컬 qwen3.5:9b — 개발·앱 작업 기본값. 무제한, 5~8초/건 (6.14 비교 승자)
# 사고 모델이므로 OLLAMA_REASONING=false 가 반드시 필요하다
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# 0 권장 — 길이 안정·규칙 준수 향상 (6.16). 창작은 줄지 않는다
LLM_TEMPERATURE=0
#
# [프리셋 1-B] Groq 무료 — 품질 검증용. 카드 불필요. 분당 8,000 토큰이 먼저 걸린다 (6.15)
# 키 발급: https://console.groq.com/keys (Billing 메뉴로 들어가지 말 것)
#LLM_PROVIDER=groq
#LLM_MODEL=openai/gpt-oss-120b
#LLM_MODEL=qwen/qwen3.8-27b
#
# [프리셋 4] OpenAI 유료 — gpt-5.6-luna. 질문 1개 약 $0.001
# OPENAI_REASONING_EFFORT=none 이 필수. 기본값(medium)이면 사고 토큰이 출력 요금으로 청구된다 (6.18)
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-5.6-luna
#OPENAI_REASONING_EFFORT=none
#
# [프리셋 2] Gemini 무료 — 프롬프트·안전 검증용. 모델당 하루 20요청 (6.10)
# 모델명은 API 로 조회해 확인한 값 (google-genai client.models.list()). gemini-2.0/2.5-flash 는 404
#LLM_PROVIDER=google
#LLM_MODEL=gemini-3.6-flash
#LLM_THINKING_LEVEL=low
#
# [프리셋 3] OpenRouter 유료 — 결제 방식(구독/크레딧) 결정 후 전환. OPENROUTER_API_KEY 만 넣으면 된다
#LLM_PROVIDER=openrouter
#LLM_MODEL=google/gemini-3.6-flash

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_TEMPERATURE=0.8
# Gemini 는 사고(thinking) 토큰도 이 한도에 포함된다. 답변이 잘리면 여기를 늘린다.
LLM_MAX_TOKENS=4096
# 사고(thinking) 제어. 비워 두면 모델 기본값. 세대별로 파라미터가 다르다.
#   3.x 계열: LLM_THINKING_LEVEL=low | medium | high (3.8-flash 는 minimal 거부)
#   2.5 계열: LLM_THINKING_BUDGET=0(끔) | -1(자동) | 토큰 수
LLM_THINKING_LEVEL=
LLM_THINKING_BUDGET=

# ─── 로컬 LLM (LLM_PROVIDER=ollama 일 때만) ────────────────
# Ollama 는 D:\Program Files\Ollama, 모델은 D:\ollama_models (OLLAMA_MODELS 사용자 환경변수)
OLLAMA_BASE_URL=http://localhost:11434
# 기본 4096 은 구절 5개 + 답변에 빠듯하다. 8192 면 VRAM 5.8GB (exaone3.5:7.8b 실측)
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# 사고(thinking) 모델용. false 로 꺼야 한다 — 켜두면 num_predict 를 사고에 다 쓰고 본문이 잘린다
OLLAMA_REASONING=false

# ─── 임베딩 ───────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
# float16 이면 VRAM 2.4GB -> 1.2GB. 남는 만큼 더 큰 로컬 LLM 을 올릴 수 있다
EMBEDDING_DTYPE=float16

# ─── 경로 ─────────────────────────────────────────────────
CORPUS_DIR=data/corpus
INDEX_DIR=data/index

# ─── 청킹 ─────────────────────────────────────────────────
# 짧은 단위는 TARGET 까지 묶고, MAX 를 넘는 단위만 문장 경계에서 쪼갠다.
# OVERLAP 은 쪼갤 때만 적용된다 (묶을 때는 경계가 이미 저자의 것이므로 불필요).
CHUNK_TARGET_TOKENS=512
CHUNK_MAX_TOKENS=640
CHUNK_OVERLAP_TOKENS=96

# ─── 검색 파라미터 ────────────────────────────────────────
# 답변이 페르소나 규칙(1인칭·말투·한국어·길이)을 어기면 지적하고 다시 생성하는 횟수
MAX_RETRIES=3

TOP_K=5
# 유사도가 이보다 낮은 구절은 근거로 쓰지 않는다.
# 낮으면 엉뚱한 구절이 섞이고, 높으면 근거 없음이 자주 뜬다.
MIN_SCORE=0.45

# ─── 요금제 (app/plans.py) ────────────────────────────────
# 로그인이 없어 모든 사용자가 이 요금제를 받는다. personal = 하루 5건, pro = 무제한.
# 테스트 단계라 pro. personal 로 바꾸면 하루 제한이 걸린다 (한국 시간 자정에 초기화)
DEFAULT_PLAN=pro

# ─── 로그인 (app/auth.py, Firebase Authentication) ────────
# Firebase 콘솔 → 프로젝트 설정 → 일반 → "프로젝트 ID". 비밀값이 아니다 (토큰 검증에만 쓴다)
FIREBASE_PROJECT_ID=
# true 면 로그인 안 한 요청을 401 로 막는다. Firebase 설정을 마칠 때까지 false
AUTH_REQUIRED=false

# ─── 서버 ─────────────────────────────────────────────────
# 0.0.0.0 이어야 같은 Wi-Fi의 실기기에서 접속할 수 있다.
HOST=0.0.0.0
PORT=8000
