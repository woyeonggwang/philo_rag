# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   copy .env.example .env
# .env 는 .gitignore 에 걸려 있다. 절대 커밋하지 말 것.

# ─── LLM 프로바이더 ───────────────────────────────────────
# 코드는 이 값 하나로 프로바이더를 교체할 수 있게 작성한다.
LLM_PROVIDER=google

GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LLM_MODEL=gemini-2.0-flash

# ─── 임베딩 ───────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# ─── 경로 ─────────────────────────────────────────────────
CORPUS_DIR=data/corpus
INDEX_DIR=data/index

# ─── 검색 파라미터 ────────────────────────────────────────
TOP_K=5

# ─── 서버 ─────────────────────────────────────────────────
# 0.0.0.0 이어야 같은 Wi-Fi의 실기기에서 접속할 수 있다.
HOST=0.0.0.0
PORT=8000
